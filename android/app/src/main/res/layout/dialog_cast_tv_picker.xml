<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_dialog"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_cast_tv"
            app:tint="#A78BFA"
            android:contentDescription="Cast" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Enviar a TV"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_cast_scanning"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:indeterminateTint="#A78BFA"
            android:visibility="visible" />

        <TextView
            android:id="@+id/btn_cast_rescan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Buscar"
            android:textColor="#DDD6FE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/bg_tv_button_selector" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_cast_scan_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscando televisores en tu red Wi-Fi..."
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:paddingBottom="10dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2E3A"
        android:layout_marginBottom="12dp" />

    <!-- Scrollable Unified TV List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="260dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/container_cast_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2E3A"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Footer Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/btn_cast_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="📱 Ver en este dispositivo"
            android:textColor="#FCA5A5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone"
            android:background="@drawable/bg_tv_button_selector" />

        <TextView
            android:id="@+id/btn_cast_dialog_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            android:text="Cerrar"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/bg_tv_button_selector" />
    </LinearLayout>

</LinearLayout>
